# Copy to .env (gitignored) and fill in. Loaded automatically from the repo root.

NAL_ENV=DEV

# Postgres DSN; migrations run at startup.
DATABASE_URL=postgres://postgres:pass@localhost:55432/nal?sslmode=disable

# 32-byte hex Ed25519 seed for a stable notary key across restarts.
# Generate: openssl rand -hex 32
NAL_NOTARY_SEED=

# Optional gateway auth: when set, gRPC calls must send x-api-key.
NAL_API_KEY=

# Solari credentials (https://console.getsolari.com). Required for recordings and examples.
SOLARI_API_KEY=
SOLARI_BASE_URL=

# Listen / dial addresses.
GRPC_ADDR=:9090
HTTP_ADDR=:8080
NAL_GRPC=localhost:9090
