### Babit API walkthrough
###
### Prerequisites:
###   make db-up      # Postgres
###   make run        # nald,    gRPC on :9090
###   make gateway    # gateway, REST on :8080
###
### Select the "dev" or "render" environment and run the steps in order (top to bottom).
### Each step captures what the next one needs and asserts its own result.

### 1. Issue a root grant for a human principal -> 200
POST {{host}}/v1/grants:root
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "principal_id": "usr_alice",
  "scope": { "max_depth": 3 }
}

> {%
    client.test("1: root issued", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.grant.grant_id, "no grant_id");
    });
    client.global.set("rootGrant", response.body.grant.grant_id);
%}

### 2. Delegate a scoped sub-grant to an agent -> 200
POST {{host}}/v1/grants
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "parent_grant_id": "{{rootGrant}}",
  "subject_id": "agt_shopper",
  "capabilities": ["browser.click"],
  "scope": { "resource_globs": ["https://shop.example.com/*"], "max_value_cents": 50000 }
}

> {%
    client.test("2: delegated", () => client.assert(response.status === 200));
    client.global.set("childGrant", response.body.grant.grant_id);
%}

### 3. Verify the delegation chain back to its root -> valid: true
GET {{host}}/v1/grants/{{childGrant}}:verify
X-Api-Key: {{apiKey}}

> {%
    client.test("3: chain valid", () => client.assert(response.body.valid === true));
%}

### 4. Begin a capture session -> 200
POST {{host}}/v1/sessions
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "root_grant_id": "{{rootGrant}}",
  "surface": "SURFACE_BROWSER"
}

> {%
    client.test("4: session started", () => client.assert(response.status === 200));
    client.global.set("sessionId", response.body.session.session_id);
%}

### 5. Record and notarize an action -> 200
POST {{host}}/v1/sessions/{{sessionId}}/actions
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "grant_id": "{{childGrant}}",
  "action_type": "browser.click",
  "resource": "https://shop.example.com/cart",
  "recording_ref": "slr://session/demo"
}

> {%
    client.test("5: action recorded", () => client.assert(response.status === 200));
    client.global.set("eventId", response.body.event.event_id);
%}

### 6. End the session (checkpoints the Merkle root) -> 200
POST {{host}}/v1/sessions/{{sessionId}}/end
Content-Type: application/json
X-Api-Key: {{apiKey}}

{}

> {%
    client.test("6: session ended", () => client.assert(response.status === 200));
%}

### 7. Read the sealed event -> 200
GET {{host}}/v1/events/{{eventId}}
X-Api-Key: {{apiKey}}

> {%
    client.test("7: event readable", () => client.assert(response.status === 200));
%}

### 8. Build an inclusion proof and keep it for step 10 -> 200
GET {{host}}/v1/events/{{eventId}}:proof
X-Api-Key: {{apiKey}}

> {%
    client.test("8: proof built", () => client.assert(response.status === 200));
    client.global.set("proof", JSON.stringify(response.body.proof));
%}

### 9. Fetch the notary public key (used for offline verification) -> 200
GET {{host}}/v1/notary/public-key
X-Api-Key: {{apiKey}}

> {%
    client.test("9: public key", () => client.assert(response.body.public_key));
%}

### 10. Verify the proof server-side -> valid: true, anchored: true
POST {{host}}/v1/proofs:verify
Content-Type: application/json
X-Api-Key: {{apiKey}}

{ "proof": {{proof}} }

> {%
    client.test("10: proof verifies", () => {
        client.assert(response.body.valid === true, "not valid");
        client.assert(response.body.anchored === true, "not anchored");
    });
%}

### 11. Fetch the session anchor -> 200
GET {{host}}/v1/sessions/{{sessionId}}/anchor
X-Api-Key: {{apiKey}}

> {%
    client.test("11: anchor present", () => client.assert(response.body.anchor.root));
%}

### 12. Revoke the agent's grant -> revoked: true
POST {{host}}/v1/grants/{{childGrant}}/revoke
Content-Type: application/json
X-Api-Key: {{apiKey}}

{ "reason": "manual test" }

> {%
    client.test("12: revoked", () => client.assert(response.body.revoked === true));
%}

### 13. Recording after revocation is denied -> 403 PERMISSION_DENIED
POST {{host}}/v1/sessions/{{sessionId}}/actions
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "grant_id": "{{childGrant}}",
  "action_type": "browser.click",
  "recording_ref": "slr://session/demo"
}

> {%
    client.test("13: denied after revoke", () => client.assert(response.status === 403, "status " + response.status));
%}
