{
  "name": "babit-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check src",
    "gen:api": "swagger2openapi ../gen/openapi/ledger.swagger.json -p -o openapi.v3.json && node scripts/openapi-tags.mjs && openapi-typescript openapi.v3.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@scalar/api-reference-react": "^0.9.66",
    "@xyflow/react": "^12.11.6",
    "cobe": "^2.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.2.2"
  }
}
