{
  "swagger": "2.0",
  "info": {
    "title": "Notarized Action Ledger",
    "description": "Tamper-evident, delegation-anchored, replayable record of AI-agent actions on Solari.",
    "version": "1.0.0"
  },
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/events/{event_id}": {
      "get": {
        "summary": "Read a sealed action event",
        "operationId": "LedgerService_GetEvent",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetEventResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ]
      }
    },
    "/v1/events/{event_id}:proof": {
      "get": {
        "summary": "Build an offline-verifiable inclusion proof",
        "operationId": "LedgerService_GetInclusionProof",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetInclusionProofResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ]
      }
    },
    "/v1/grants": {
      "post": {
        "summary": "Delegate scoped authority to an agent or sub-agent",
        "operationId": "DelegationService_Delegate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DelegateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1DelegateRequest"
            }
          }
        ]
      }
    },
    "/v1/grants/{grant_id}/revoke": {
      "post": {
        "summary": "Revoke a grant and its descendants",
        "operationId": "DelegationService_Revoke",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RevokeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "grant_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DelegationServiceRevokeBody"
            }
          }
        ]
      }
    },
    "/v1/grants/{grant_id}:verify": {
      "get": {
        "summary": "Verify a delegation chain back to its root",
        "operationId": "DelegationService_VerifyChain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1VerifyChainResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "grant_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ]
      }
    },
    "/v1/grants:root": {
      "post": {
        "summary": "Issue a root grant for a human principal",
        "operationId": "DelegationService_IssueRootGrant",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1IssueRootGrantResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1IssueRootGrantRequest"
            }
          }
        ]
      }
    },
    "/v1/notary/public-key": {
      "get": {
        "summary": "Fetch the notary public key for offline verification",
        "operationId": "NotaryService_GetPublicKey",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetPublicKeyResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        }
      }
    },
    "/v1/proofs:verify": {
      "post": {
        "summary": "Verify chain, signature, anchor and authority of a proof",
        "operationId": "VerifyService_VerifyProof",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1VerifyProofResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1VerifyProofRequest"
            }
          }
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Open a capture session bound to a root grant",
        "operationId": "CaptureService_BeginSession",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1BeginSessionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1BeginSessionRequest"
            }
          }
        ]
      }
    },
    "/v1/sessions/{session_id}/actions": {
      "post": {
        "summary": "Record and notarize one executed action",
        "operationId": "CaptureService_RecordAction",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RecordActionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CaptureServiceRecordActionBody"
            }
          }
        ]
      }
    },
    "/v1/sessions/{session_id}/anchor": {
      "get": {
        "summary": "Fetch the external anchor for a session",
        "operationId": "NotaryService_GetAnchor",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetAnchorResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ]
      }
    },
    "/v1/sessions/{session_id}/end": {
      "post": {
        "summary": "Close a capture session",
        "operationId": "CaptureService_EndSession",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1EndSessionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CaptureServiceEndSessionBody"
            }
          }
        ]
      }
    },
    "/v1/sessions/{session_id}:replay": {
      "get": {
        "summary": "Stream a deterministic session replay",
        "operationId": "ReplayService_GetReplay",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1GetReplayResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1GetReplayResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ]
      }
    }
  },
  "definitions": {
    "AnchorKind": {
      "type": "string",
      "enum": [
        "KIND_UNSPECIFIED",
        "KIND_RFC3161_TSA",
        "KIND_TRANSPARENCY_LOG",
        "KIND_PUBLIC_CHAIN"
      ],
      "default": "KIND_UNSPECIFIED"
    },
    "CaptureServiceEndSessionBody": {
      "type": "object"
    },
    "CaptureServiceRecordActionBody": {
      "type": "object",
      "example": {
        "grant_id": "BAL-417849",
        "action_type": "browser.click",
        "resource": "https://shop.example.com/cart",
        "recording_ref": "slr://session/demo"
      },
      "properties": {
        "grant_id": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "action_payload": {
          "type": "string",
          "format": "byte"
        },
        "pre_state_hash": {
          "type": "string",
          "format": "byte"
        },
        "post_state_hash": {
          "type": "string",
          "format": "byte"
        },
        "recording_ref": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "value_cents": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "DelegationServiceRevokeBody": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ActionEvent": {
      "type": "object",
      "example": {
        "event_id": "BAL-778812",
        "session_id": "BAL-4a1055",
        "sequence": 7,
        "surface": "SURFACE_BROWSER",
        "action_type": "browser.click",
        "grant_id": "BAL-417849",
        "recording_ref": "slr://session/demo",
        "occurred_at": "2026-09-01T12:03:11Z"
      },
      "properties": {
        "event_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "format": "int64"
        },
        "surface": {
          "$ref": "#/definitions/v1Surface"
        },
        "action_type": {
          "type": "string"
        },
        "action_payload": {
          "type": "string",
          "format": "byte"
        },
        "grant_id": {
          "type": "string"
        },
        "pre_state_hash": {
          "type": "string",
          "format": "byte"
        },
        "post_state_hash": {
          "type": "string",
          "format": "byte"
        },
        "recording_ref": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "format": "byte"
        },
        "prev_hash": {
          "type": "string",
          "format": "byte"
        },
        "notary_signature": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1Anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/AnchorKind"
        },
        "root": {
          "type": "string",
          "format": "byte"
        },
        "anchor_receipt": {
          "type": "string",
          "format": "byte"
        },
        "anchored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1BeginSessionRequest": {
      "type": "object",
      "example": {
        "root_grant_id": "BAL-417849",
        "surface": "SURFACE_BROWSER"
      },
      "properties": {
        "root_grant_id": {
          "type": "string"
        },
        "surface": {
          "$ref": "#/definitions/v1Surface"
        }
      }
    },
    "v1BeginSessionResponse": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/definitions/v1Session"
        }
      }
    },
    "v1DelegateRequest": {
      "type": "object",
      "example": {
        "parent_grant_id": "BAL-417849",
        "subject_id": "agt_shopper",
        "capabilities": [
          "browser.click",
          "browser.type"
        ],
        "scope": {
          "resource_globs": [
            "https://shop.example.com/*"
          ],
          "max_value_cents": 50000,
          "max_depth": 2
        }
      },
      "properties": {
        "parent_grant_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "$ref": "#/definitions/v1Scope"
        }
      }
    },
    "v1DelegateResponse": {
      "type": "object",
      "properties": {
        "grant": {
          "$ref": "#/definitions/v1Grant"
        }
      }
    },
    "v1EndSessionResponse": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/definitions/v1Session"
        }
      }
    },
    "v1GetAnchorResponse": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/definitions/v1Anchor"
        }
      }
    },
    "v1GetEventResponse": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/v1ActionEvent"
        }
      }
    },
    "v1GetInclusionProofResponse": {
      "type": "object",
      "properties": {
        "proof": {
          "$ref": "#/definitions/v1Proof"
        }
      }
    },
    "v1GetPublicKeyResponse": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "public_key": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1GetReplayResponse": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/v1ActionEvent"
        },
        "frame": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1Grant": {
      "type": "object",
      "example": {
        "grant_id": "BAL-417849",
        "parent_grant_id": "BAL-100200",
        "principal_id": "usr_alice",
        "subject_id": "agt_shopper",
        "capabilities": [
          "browser.click",
          "browser.type"
        ],
        "scope": {
          "resource_globs": [
            "https://shop.example.com/*"
          ],
          "max_value_cents": 50000,
          "max_depth": 2
        },
        "expires_at": "2026-09-01T18:00:00Z"
      },
      "properties": {
        "grant_id": {
          "type": "string"
        },
        "parent_grant_id": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "$ref": "#/definitions/v1Scope"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "parent_signature": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1IssueRootGrantRequest": {
      "type": "object",
      "example": {
        "principal_id": "usr_alice",
        "scope": {
          "max_depth": 3
        }
      },
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/v1Scope"
        }
      }
    },
    "v1IssueRootGrantResponse": {
      "type": "object",
      "properties": {
        "grant": {
          "$ref": "#/definitions/v1Grant"
        }
      }
    },
    "v1Proof": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/v1ActionEvent"
        },
        "merkle_path": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "byte"
          }
        },
        "merkle_root": {
          "type": "string",
          "format": "byte"
        },
        "anchor": {
          "$ref": "#/definitions/v1Anchor"
        },
        "delegation_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Grant"
          }
        }
      }
    },
    "v1RecordActionResponse": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/v1ActionEvent"
        }
      }
    },
    "v1RevokeResponse": {
      "type": "object",
      "properties": {
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "v1Scope": {
      "type": "object",
      "properties": {
        "resource_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_value_cents": {
          "type": "string",
          "format": "int64"
        },
        "max_depth": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1Session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "root_grant_id": {
          "type": "string"
        },
        "surface": {
          "$ref": "#/definitions/v1Surface"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_count": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1Surface": {
      "type": "string",
      "enum": [
        "SURFACE_UNSPECIFIED",
        "SURFACE_BROWSER",
        "SURFACE_SANDBOX",
        "SURFACE_DESKTOP"
      ],
      "default": "SURFACE_UNSPECIFIED"
    },
    "v1VerifyChainResponse": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Grant"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "v1VerifyProofRequest": {
      "type": "object",
      "properties": {
        "proof": {
          "$ref": "#/definitions/v1Proof"
        }
      }
    },
    "v1VerifyProofResponse": {
      "type": "object",
      "example": {
        "valid": true,
        "chain_intact": true,
        "signature_valid": true,
        "anchored": true,
        "authority_valid": true,
        "reason": ""
      },
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "chain_intact": {
          "type": "boolean"
        },
        "signature_valid": {
          "type": "boolean"
        },
        "anchored": {
          "type": "boolean"
        },
        "authority_valid": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
